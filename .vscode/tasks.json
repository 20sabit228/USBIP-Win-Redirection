{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "label": "Build libusb Enumerator",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "${workspaceFolder}/main.cpp",
        "-o",
        "${workspaceFolder}/main.exe",
        "-I",
        "C:/libusb/include",
        "C:/libusb/MinGW64/static/libusb-1.0.a",
        "-lcfgmgr32",
        "-lsetupapi"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}